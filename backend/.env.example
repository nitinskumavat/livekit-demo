# Local LiveKit server (`livekit-server --dev` uses these built-in dev credentials)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Speech-to-text: https://console.deepgram.com
DEEPGRAM_API_KEY=

# LLM ("brain"): gemini or openai. Only the selected provider's key is needed.
LLM_PROVIDER=gemini

# Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Text-to-speech: https://play.cartesia.ai
CARTESIA_API_KEY=
